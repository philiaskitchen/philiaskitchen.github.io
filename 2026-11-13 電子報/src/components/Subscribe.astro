---
// 電子報訂閱欄位（Mailchimp）。NEWSLETTER.action 空白時隱藏；網址加 ?news=preview 可以先預覽。
// 用 Mailchimp 的 post-json（JSONP）送出，結果直接顯示在欄位下面；JS 失敗時退回一般表單送出（開新分頁）。
import { NEWSLETTER } from '../site';
import { getLang, lp, t } from '../i18n';
const lang = getLang(Astro.url);
const n = t(lang).news;
const action = NEWSLETTER.action;
const q = action.split('?')[1] ?? '';
const params = new URLSearchParams(q);
const honeypot = `b_${params.get('u') ?? ''}_${params.get('id') ?? ''}`;
---
<section class="news" data-news data-action={action} hidden={!action}>
  <div class="wrap">
    <div class="card paper">
      <div class="txt">
        <h2 class="display">{n.title}</h2>
        <p class="soft">{n.sub}</p>
      </div>
      <form action={action || '#'} method="post" target="_blank" novalidate>
        <label class="sr" for={`news-${lang}`}>{n.label}</label>
        <input id={`news-${lang}`} type="email" name="EMAIL" placeholder={n.ph} autocomplete="email" required />
        <div aria-hidden="true" style="position:absolute;left:-5000px"><input type="text" name={honeypot} tabindex="-1" value="" /></div>
        <button type="submit">{n.btn}</button>
        <p class="msg" role="status" aria-live="polite" data-sending={n.sending} data-ok={n.ok} data-err={n.err}></p>
        <p class="fine"><a href={lp(lang, '/privacy/')}>{n.privacy}</a></p>
      </form>
    </div>
  </div>
</section>
<script is:inline>
(() => {
  const box = document.querySelector('[data-news]'); if (!box) return;
  if (box.hidden && /[?&]news=preview/.test(location.search)) box.hidden = false;
  const action = box.dataset.action; const form = box.querySelector('form'); const msg = box.querySelector('.msg');
  if (!action) { form.addEventListener('submit', (e) => e.preventDefault()); return; }
  form.addEventListener('submit', (e) => {
    const email = form.EMAIL.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { e.preventDefault(); msg.textContent = msg.dataset.err; return; }
    e.preventDefault(); msg.textContent = msg.dataset.sending;
    const cb = 'mc' + Date.now(); const s = document.createElement('script');
    const done = (ok) => { msg.textContent = ok ? msg.dataset.ok : msg.dataset.err; if (ok) form.EMAIL.value = ''; delete window[cb]; s.remove(); };
    window[cb] = (r) => {
      const already = r && r.msg && /already subscribed/i.test(r.msg);
      done(r && (r.result === 'success' || already));
      if (window.gtag && r && r.result === 'success') gtag('event', 'newsletter_signup');
    };
    s.onerror = () => done(false);
    s.src = action.replace('/post?', '/post-json?') + '&EMAIL=' + encodeURIComponent(email) + '&c=' + cb;
    document.body.appendChild(s);
  });
})();
</script>
<style>
  .news { padding: 48px 0 8px; }
  .card { display: flex; gap: 28px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 28px 32px; border-radius: 12px; background: var(--paper); box-shadow: var(--shadow-paper); }
  .txt { flex: 1 1 280px; }
  h2 { font-size: 24px; margin: 0 0 6px; }
  .soft { margin: 0; font-size: 15px; color: var(--ink-soft); }
  form { flex: 1 1 320px; display: flex; flex-wrap: wrap; gap: 10px; position: relative; }
  input[type=email] { flex: 1 1 200px; min-width: 0; font: inherit; font-size: 16px; padding: 12px 16px; border: 2px dashed var(--line-dashed); border-radius: 999px; background: var(--sage); color: var(--ink); }
  input[type=email]:focus { outline: none; border-color: var(--olive); border-style: solid; }
  button { font: inherit; font-size: 16px; padding: 12px 26px; border: 0; border-radius: 999px; background: var(--terracotta); color: var(--on-terracotta); cursor: pointer; letter-spacing: .04em; }
  button:hover { background: var(--terracotta-ink); }
  .msg { flex-basis: 100%; margin: 0; font-size: 14px; color: var(--olive-ink); min-height: 1em; }
  .msg:empty { display: none; }
  .fine { flex-basis: 100%; margin: 0; font-size: 12px; }
  .fine a { color: var(--ink-soft); border-bottom: 1px solid currentColor; }
  form, .txt { min-width: 0; }
  @media (max-width: 560px) { .card { padding: 24px 20px; gap: 18px; } input[type=email], button { flex-basis: 100%; } }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
