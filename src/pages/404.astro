---
import Base from '../layouts/Base.astro';
import ScallopButton from '../components/ScallopButton.astro';
---
<Base title="找不到這一頁 · Page not found" alt={null}>
  <section class="wrap" style="padding:60px 30px 80px;text-align:center">
    <h1 class="display" style="font-size:44px">這一頁還在烤箱裡</h1>
    <p class="muted" style="margin:12px 0 6px">找不到你要的頁面，回首頁看看別的食譜吧。</p>
    <p class="muted" lang="en" style="margin:0 0 22px">This page is still in the oven — I couldn't find it. <a class="link" href="/en/">Back to the English site</a></p>
    <ScallopButton href="/" label="回到首頁" width={170} />
  </section>
</Base>
