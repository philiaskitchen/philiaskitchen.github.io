---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';
---
<Base title="關於我" description="寫食譜的人：關於 Philia 和這個食譜網站。" active="about">
  <section class="wrap intro">
    <div>
      <div class="fr eyebrow">à propos —</div>
      <h1 class="display">寫食譜的人</h1>
      <p class="muted">住在澳洲的 Philia，有個台灣胃，也是個甜點控。</p>
      <p class="muted">以前是朝九晚五的上班族，對廚房總有種陌生和害怕。最近多了一些自己的時間，開始試著做些簡單的點心給家人吃，意外發現做點心是一段很療癒的時光。時間好像都慢了下來，我好喜歡這種感覺！如果你也想試試，歡迎使用我的食譜。</p>
      {/*
        原本的版本（想換回去時，把上面兩段換成這段）：
        住在澳洲的Philia，是個台灣胃，也是個甜點控。以前是個朝九晚五的上班族，對廚房總是有種陌生和懼怕。就在最近閒了下來，開始嘗試做些簡單的點心給家人吃。意外的發現做點心是個療心的時間，時光都慢了下來，好喜歡這樣的時光! 如果你也想試試，歡迎使用我的食譜。
      */}
    </div>
    <img src="/images/site/about-tools.webp" alt="攪拌碗、陶壺、砧板、打蛋器和隔熱手套的插圖" width="1000" height="444" />
  </section>
  <img class="divider" src="/images/ui/divider.svg" alt="" aria-hidden="true" />
  <section class="wrap how">
    <div class="section-title"><h2>這裡的食譜怎麼看</h2><span class="fr">mode d'emploi</span></div>
    <div class="notes">
      <Note title="份量都用克" items={['麵粉、糖、油都寫重量，比用杯子準。', '液體用 ml，溫度用 °C。']} tape="var(--mustard)" tilt={-1} />
      <Note title="失敗也寫下來" items={['我做壞過的地方，會寫在「我失敗過的地方」。', '第一次做之前先看一眼。']} bg="var(--paper-cream)" tape="var(--tape-sage)" tilt={0.8} />
      <Note title="為什麼有法文名" items={['我喜歡法式甜點，也喜歡它們的名字。', '台式點心也取一個，好玩而已。']} tape="var(--dusty-blue)" tilt={-0.6} />
    </div>
  </section>
</Base>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 50px; align-items: center; padding-top: 40px; padding-bottom: 30px; }
  .eyebrow { color: var(--olive-ink); font-size: 22px; }
  h1 { font-size: 52px; line-height: 1.25; margin-top: 4px; }
  .intro p { font-size: 17px; line-height: 2; margin-top: 16px; max-width: 520px; }
  .how { padding-top: 34px; padding-bottom: 60px; }
  .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 34px; }
  @media (max-width: 860px) { .intro, .notes { grid-template-columns: minmax(0, 1fr); } .intro img { order: -1; width: 100%; max-width: 560px; margin: 0 auto; } }
</style>
