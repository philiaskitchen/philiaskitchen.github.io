---
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import RecipeMenu from '../components/RecipeMenu.astro';
import ScallopButton from '../components/ScallopButton.astro';
import { allRecipes, featuredRecipe, recipeUrl, CATEGORIES } from '../site';
const recipes = await allRecipes();
const featured = await featuredRecipe();
const latest = recipes.slice(0, 3);
const kind = featured ? (featured.data.category === 'french' ? '一盤' : featured.data.category === 'bread' ? '一爐' : '一籠') : '';
---
<Base home active="week">
  <section class="wrap hero">
    <div class="copy">
      <div class="fr eyebrow">Cette semaine —</div>
      {featured ? (
        <h1 class="display">這週的點心，<br />是{kind} <span class="circle">{featured.data.title}</span>。</h1>
      ) : (
        <h1 class="display">這週的點心，<br />還在廚房裡。</h1>
      )}
      <p class="muted lead">我把家裡常做的台式點心和法式甜點，一道一道記下來。<br />份量、時間、失敗過的地方都寫在裡面。</p>
      <div class="actions">
        {featured && <ScallopButton href={recipeUrl(featured)} label="看這週的食譜" width={200} />}
        <a class="link" href="#menu">全部食譜</a>
      </div>
    </div>
    <img class="banner" src="/images/site/banner-home.webp" alt="蒸籠裡的花捲、茶壺、法棍和瑪德蓮的插圖" width="796" height="502" />
  </section>
  <img class="divider" src="/images/ui/divider.svg" alt="" aria-hidden="true" />

  <section class="wrap latest">
    <div class="section-title"><h2>最近做的</h2><span class="fr">les dernières recettes</span></div>
    <div class="card-grid">{latest.map((r, i) => <RecipeCard recipe={r} index={i} />)}</div>
  </section>

  <div class="band" id="menu">
    <section class="wrap duo">
      <div class="menu-col"><RecipeMenu recipes={recipes} /></div>
      <div class="about-col">
        <img src="/images/site/stilllife-teapot.webp" alt="蒸籠、茶壺和蔥的插圖" loading="lazy" width="1000" height="647" />
        <h2 class="display">寫食譜的人</h2>
        <p class="muted">住在澳洲的 Philia，有個台灣胃，也是個甜點控。如果你也想試試，歡迎使用我的食譜。</p>
        <a class="link" href="/about/">更多關於我</a>
      </div>
    </section>
  </div>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1fr 1.1fr; align-items: center; gap: 30px; padding-top: 40px; padding-bottom: 30px; }
  .eyebrow { color: var(--olive-ink); font-size: 22px; }
  h1 { font-size: 48px; line-height: 1.3; margin-top: 4px; }
  .circle { position: relative; display: inline-block; padding: 0 6px; }
  .circle::after { content: ""; position: absolute; inset: -14px -16px -10px -16px; background: url(/images/ui/pencil-circle.svg) no-repeat center / 100% 100%; pointer-events: none; }
  .lead { margin-top: 14px; line-height: 1.9; }
  .actions { display: flex; align-items: center; gap: 18px; margin-top: 18px; flex-wrap: wrap; }
  .banner { justify-self: end; width: 100%; max-width: 560px; }
  .latest { padding-top: 30px; padding-bottom: 50px; }
  .latest .card-grid { margin-top: 32px; }
  .band { padding: 44px 0 50px; scroll-margin-top: 20px; }
  .duo { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: start; }
  .about-col img { max-height: 270px; width: auto; margin: 0 auto; }
  .about-col h2 { font-size: 28px; margin-top: 6px; }
  .about-col p { font-size: 15px; line-height: 1.9; margin: 6px 0 12px; }
  @media (max-width: 860px) {
    .hero, .duo { grid-template-columns: 1fr; }
    .banner { order: -1; justify-self: center; }
    h1 { font-size: 36px; }
  }
</style>
