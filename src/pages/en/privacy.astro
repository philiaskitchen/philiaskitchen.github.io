---
import Base from '../../layouts/Base.astro';
import { ADS } from '../../site';
import EmailLink from '../../components/EmailLink.astro';
const adsLive = Boolean(ADS.client);
---
<Base title="Privacy policy" description="How Philia's Kitchen handles your data: no sign-up, your ticks stay on your own device, and how ads and cookies work.">
  <article class="wrap policy">
    <div class="fr eyebrow">confidentialité —</div>
    <h1 class="display">Privacy policy</h1>
    <p class="soft updated">Last updated: 29 October 2026</p>

    <section class="paper sheet">
      <h2 class="display">About this site</h2>
      <p>Philia's Kitchen is my personal recipe website. You don't need to sign up or log in to read the recipes, and the site never asks for your name, email or other personal details.</p>

      <h2 class="display">Data kept on your device</h2>
      <p>The ingredients and steps you tick, and any timers you start, are saved only in your own browser's local storage (localStorage), so they are still there when you reload the page. This data is never sent to me or to anyone else.</p>
      <p>To delete it, tap "Start over" on the recipe page, or clear this site's data in your browser.</p>

      <h2 class="display">Hosting</h2>
      <p>This site is hosted on GitHub Pages. To keep the service secure and running, GitHub may log technical information such as visitors' IP addresses. See the <a class="link" href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub General Privacy Statement</a> for details.</p>

      <h2 class="display">Ads and cookies</h2>
      {adsLive ? (
        <p>This site uses Google AdSense to show ads.</p>
      ) : (
        <p>This site does not show ads at the moment. It may use Google AdSense in the future; once ads are shown, the following applies.</p>
      )}
      <ul>
        <li>Third-party vendors, including Google, use cookies to serve ads based on your previous visits to this website or other websites.</li>
        <li>Google's use of advertising cookies enables it and its partners to serve ads to you based on your visits to this site and/or other sites on the internet.</li>
        <li>You can opt out of personalised advertising in <a class="link" href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ads Settings</a>, and opt out of other third-party vendors' cookies at <a class="link" href="https://www.aboutads.info/choices/" target="_blank" rel="noopener">aboutads.info</a>.</li>
        <li>To learn how Google uses this data, see <a class="link" href="https://policies.google.com/technologies/partner-sites?hl=en" target="_blank" rel="noopener">How Google uses information from sites or apps that use our services</a>.</li>
      </ul>
      <p>If you are in the European Economic Area, the UK or Switzerland, the site will ask for your consent before using cookies, and you can choose not to agree.</p>

      <h2 class="display" id="contact">Contact</h2>
      <p>If you have any questions about this policy or the site, please email me: <EmailLink show class="link" /></p>

      <h2 class="display">Changes to this policy</h2>
      <p>If this policy changes, I will update this page and the "Last updated" date above.</p>
    </section>
  </article>
</Base>
<style>
  .policy { max-width: 820px; padding-top: 34px; padding-bottom: 70px; }
  .eyebrow { color: var(--olive-ink); font-size: 22px; }
  h1 { font-size: 48px; line-height: 1.25; margin-top: 4px; }
  .updated { font-size: 14px; margin-top: 6px; }
  .sheet { margin-top: 28px; padding: 34px 38px 30px; }
  h2 { font-size: 24px; line-height: 1.35; margin-top: 30px; }
  h2:first-child { margin-top: 0; }
  p, li { font-size: 16px; line-height: 1.95; color: var(--ink-muted); }
  p { margin-top: 10px; }
  ul { margin: 10px 0 0; padding-left: 22px; }
  li + li { margin-top: 6px; }
  .link { font-size: inherit; }
  @media (max-width: 600px) { h1 { font-size: 38px; } .sheet { padding: 26px 20px 22px; } }
</style>
