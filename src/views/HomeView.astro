---
// 首頁（中英文共用）
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import RecipeMenu from '../components/RecipeMenu.astro';
import ScallopButton from '../components/ScallopButton.astro';
import SteamyStillLife from '../components/SteamyStillLife.astro';
import FortuneDraw from '../components/FortuneDraw.astro';
import GingerWorkshop from '../components/GingerWorkshop.astro';
import PeekCat from '../components/PeekCat.astro';
import { allRecipes, featuredRecipe, recipeUrl, smallImage } from '../site';
import { getLang, lp, t } from '../i18n';
const lang = getLang(Astro.url);
const u = t(lang);
const recipes = await allRecipes(lang);
const featured = await featuredRecipe(lang);
const latest = recipes.slice(0, 3);
const favData = Object.fromEntries(recipes.map((r) => [r.id, { t: r.data.title, u: recipeUrl(r, lang), i: r.data.image ? smallImage(r.data.image) : '' }]));
const hw = featured ? u.heroWeek(featured.data.measure || u.kind[featured.data.category] || '', featured.data.title) : null;
---
<Base home active="week">
  <section class="wrap hero">
    <div class="copy">
      <p class="greet" hidden><span class="g1"></span><span class="g2"></span></p>
      <div class="fr eyebrow">Cette semaine —</div>
      {hw ? (
        lang === 'en' ? (
          <h1 class="display en">{hw.before}<span class="under">{hw.title}</span></h1>
        ) : (
          <h1 class="display">{hw.before}<br />{hw.mid}<span class="circle">{hw.title}</span>{hw.after}</h1>
        )
      ) : (
        <h1 class="display" set:html={u.heroEmpty} />
      )}
      <p class="muted lead" set:html={u.lead} />
      <div class="actions">
        {featured && <ScallopButton href={recipeUrl(featured, lang)} label={u.seeWeek} width={lang === 'en' ? 230 : 200} />}
        <a class="link" href="#menu">{u.allRecipes}</a>
      </div>
    </div>
    {featured?.data.image ? (
      <a class="banner feat" href={recipeUrl(featured, lang)} aria-label={featured.data.title}>
        <img src={featured.data.image} srcset={`${smallImage(featured.data.image)} 720w, ${featured.data.image} 1100w`} sizes="(max-width: 860px) 90vw, 560px" alt={u.illus(featured.data.title)} width="1100" height="752" fetchpriority="high" />
      </a>
    ) : (
      <img class="banner" src="/images/site/banner-home.webp" alt={u.bannerAlt} width="796" height="502" />
    )}
  </section>
  <img class="divider" src="/images/ui/divider.svg" alt="" aria-hidden="true" />

  <section class="wrap favs" hidden>
    <div class="section-title"><h2>{u.fav.title}</h2><span class="fr">{u.fav.fr}</span><a class="link seeall" href={lp(lang, '/favorites/')}>{u.fav.seeAll} →</a></div>
    <ul class="fav-list"></ul>
    <script type="application/json" class="fav-data" set:html={JSON.stringify({ r: favData, remove: u.fav.remove })} />
  </section>

  <section class="wrap latest">
    <div class="section-title"><h2>{u.latest}</h2><span class="fr">les dernières recettes</span></div>
    <div class="card-grid">{latest.map((r, i) => <RecipeCard recipe={r} index={i} />)}</div>
  </section>

  <GingerWorkshop />

  <FortuneDraw recipes={recipes} />

  <div class="band" id="menu">
    <section class="wrap duo">
      <div class="menu-col"><RecipeMenu recipes={recipes} /><PeekCat /></div>
      <div class="about-col">
        <SteamyStillLife alt={u.stillAlt} />
        <h2 class="display">{u.whoWrites}</h2>
        <p class="muted">{u.aboutShort}</p>
        <a class="link" href={lp(lang, '/about/')}>{u.moreAbout}</a>
      </div>
    </section>
  </div>
</Base>
<script>
  // 「我想做的食譜」：讀這台裝置存的愛心清單（食譜頁按愛心加入）
  const sec = document.querySelector<HTMLElement>('.favs');
  if (sec) {
    const D = JSON.parse(sec.querySelector('.fav-data')?.textContent || '{}');
    const list = sec.querySelector<HTMLElement>('.fav-list')!;
    const get = (): string[] => { try { return JSON.parse(localStorage.getItem('pk-favs') || '[]'); } catch { return []; } };
    const draw = () => {
      const ids = get().filter((id) => D.r[id]);
      list.innerHTML = '';
      ids.forEach((id, k) => {
        const r = D.r[id]; const li = document.createElement('li'); li.style.setProperty('--tilt', `${[-1.5, 1.2, -0.8, 1.6][k % 4]}deg`);
        const a = document.createElement('a'); a.href = r.u;
        if (r.i) { const img = document.createElement('img'); img.src = r.i; img.alt = ''; img.loading = 'lazy'; a.append(img); }
        const t = document.createElement('span'); t.className = 'display'; t.textContent = r.t; a.append(t);
        const x = document.createElement('button'); x.type = 'button'; x.className = 'x'; x.textContent = '×'; x.setAttribute('aria-label', `${D.remove}：${r.t}`);
        x.addEventListener('click', () => { try { localStorage.setItem('pk-favs', JSON.stringify(get().filter((v) => v !== id))); } catch {} draw(); dispatchEvent(new Event('pk-favs')); });
        li.append(a, x); list.append(li);
      });
      sec.hidden = ids.length === 0;
    };
    draw();
    addEventListener('pageshow', draw);
  }
</script>
<style>
  .favs { padding-top: 34px; }
  .seeall { margin-left: auto; }
  .fav-list { list-style: none; margin: 22px 0 0; padding: 0; display: flex; gap: 22px; overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x mandatory; }
  :global(.fav-list li) { position: relative; flex: none; width: 170px; scroll-snap-align: start; transform: rotate(var(--tilt)); }
  :global(.fav-list a) { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 12px 12px; background: var(--paper); box-shadow: var(--shadow-paper); text-align: center; transition: transform .2s; }
  :global(.fav-list a:hover) { transform: translateY(-3px); }
  :global(.fav-list img) { height: 90px; width: 100%; object-fit: contain; }
  :global(.fav-list .display) { font-size: 18px; line-height: 1.3; }
  :global(.fav-list li::before) { content: "♥"; position: absolute; top: -10px; left: 50%; transform: translateX(-50%); z-index: 1; color: var(--terracotta); font-size: 18px; }
  :global(.fav-list .x) { position: absolute; top: 4px; right: 6px; width: 26px; height: 26px; border: 0; background: none; color: var(--ink-soft); font-size: 18px; line-height: 1; cursor: pointer; border-radius: 50%; }
  :global(.fav-list .x:hover) { background: var(--sage); color: var(--terracotta-ink); }
  .hero { display: grid; grid-template-columns: 1fr 1.1fr; align-items: center; gap: 30px; padding-top: 40px; padding-bottom: 30px; }
  .eyebrow { color: var(--olive-ink); font-size: 22px; }
  h1 { font-size: 48px; line-height: 1.3; margin-top: 4px; }
  h1.en { font-size: 44px; line-height: 1.25; }
  .under { display: block; color: var(--terracotta-ink); padding-bottom: 8px; background: url(/images/ui/underline.svg) no-repeat left bottom / min(100%, 420px) 12px; width: fit-content; }
  .circle { position: relative; display: inline-block; padding: 0 6px; }
  .circle::after { content: ""; position: absolute; inset: -14px -16px -10px -16px; background: url(/images/ui/pencil-circle.svg) no-repeat center / 100% 100%; pointer-events: none; }
  .lead { margin-top: 14px; line-height: 1.9; }
  .actions { display: flex; align-items: center; gap: 18px; margin-top: 18px; flex-wrap: wrap; }
  .banner { justify-self: end; width: 100%; max-width: 560px; }
  .banner.feat { display: block; transition: transform .25s ease; }
  .banner.feat:hover { transform: rotate(-1deg) scale(1.01); }
  .banner.feat img { width: 100%; height: auto; }
  .latest { padding-top: 30px; padding-bottom: 50px; }
  .latest .card-grid { margin-top: 32px; }
  .band { padding: 44px 0 50px; scroll-margin-top: 20px; }
  .duo { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 56px; align-items: start; }
  .menu-col { position: relative; }
  .about-col h2 { font-size: 28px; margin-top: 6px; }
  .about-col p { font-size: 15px; line-height: 1.9; margin: 6px 0 12px; }
  @media (max-width: 860px) {
    .hero, .duo { grid-template-columns: minmax(0, 1fr); }
    .banner { order: -1; justify-self: center; }
    .banner.feat { max-width: 380px; }
    h1 { font-size: 36px; }
  }
</style>
