    background: url(/images/ui/step-circle.svg) no-repeat center / 100% 100%; }
  .steps .st { display: block; font-size: 24px; line-height: 1.35; }
  .steps .sp { display: block; white-space: pre-line; margin-top: 4px; line-height: 1.9; }
