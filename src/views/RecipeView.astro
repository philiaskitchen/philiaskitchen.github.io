---
// 食譜內頁（中文 /recipes/xxx/ 和英文 /en/recipes/xxx/ 共用）
import RollingPinProgress from '../components/RollingPinProgress.astro';
import TriviaCard from '../components/TriviaCard.astro';
import { TRIVIA } from '../data/trivia';
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import Note from '../components/Note.astro';
import RecipeCard from '../components/RecipeCard.astro';
import ScallopButton from '../components/ScallopButton.astro';
import AdSlot from '../components/AdSlot.astro';
import { allRecipes, CUISINES, catName, categoryUrl, recipeUrl, isoDuration, smallImage, type Recipe } from '../site';
import { getLang, lp, t } from '../i18n';

const { recipe } = Astro.props as { recipe: Recipe };
const lang = getLang(Astro.url);
const u = t(lang);
const other = u.switchLang;
const d = recipe.data;
const others = (await allRecipes(lang)).filter((r) => r.id !== recipe.id).slice(0, 3);
// 另一個語言有沒有這篇（英文還沒翻譯的話，語言切換會回到英文首頁）
const altExists = (await allRecipes(other)).some((r) => r.id === recipe.id);
// 「發酵 40–50 分鐘」「蒸 12–15 分鐘＋悶 3–5 分鐘」「Steam 12–15 min + rest 3–5 min」→ 一段一段的計時器
const UNIT = /(小時|分鐘|分|秒|hours?|hrs?|minutes?|mins?|min|seconds?|secs?)/i;
const parseTimer = (tm: string) => tm.split(/\s*[＋+]\s*/).map((seg) => {
  const text = seg.trim();
  const m = text.match(new RegExp('^(.*?)(\\d+(?:\\.\\d+)?)\\s*(?:(?:[–\\-~～至]|to)\\s*(\\d+(?:\\.\\d+)?))?\\s*' + UNIT.source, 'i'));
  if (!m) return { text, min: 0, max: 0, label: '' };
  const un = m[4].toLowerCase();
  const unit = /^(小時|h)/.test(un) ? 3600 : /^(秒|s)/.test(un) ? 1 : 60;
  const lb = m[1].trim();
  return { text, label: lb.charAt(0).toUpperCase() + lb.slice(1), min: Math.round(Number(m[2]) * unit), max: m[3] ? Math.round(Number(m[3]) * unit) : 0 };
});
// 份量調整：從「約 4 杯」「6–8 顆」「about 4 cups」取出基準數量和單位
const sm = d.servings.match(/(\d+(?:\.\d+)?)(?:\s*[–\-~～]\s*\d+(?:\.\d+)?)?\s*([^\d\s（(]+)?/);
const baseCount = sm ? Number(sm[1]) : 0;
const unit = sm?.[2] ?? '';
// 蛋不好切成小數顆：換算後不是整數時，旁邊補上大約的克數（全蛋約 50 g、蛋黃約 18 g）
const eggGrams = (name: string, amount: string) => {
  if (!/^\s*\d+(\.\d+)?\s*(顆|個)?\s*$/.test(amount)) return undefined;
  if (/蛋黃|yolk/i.test(name)) return '18';
  if (/蛋|egg/i.test(name) && !/蛋液|beaten/i.test(name)) return '50';
  return undefined;
};
const stars = '★'.repeat(Number(d.difficulty)) + '☆'.repeat(3 - Number(d.difficulty));
const meta = [
  [u.prep, d.prepTime], [d.waitLabel, d.waitTime], [d.cookLabel, d.cookTime], [u.servings, d.servings], [u.difficulty, stars],
].filter(([k, v]) => k && v);
const longTitle = lang === 'en' ? d.title.length > 22 : d.title.length > 6;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const nu = d.nutrition;
const ld = {
  '@context': 'https://schema.org', '@type': 'Recipe', name: d.title, description: d.intro,
  image: d.image ? [new URL(d.image, Astro.site).href] : undefined,
  author: { '@type': 'Person', name: 'Philia' }, datePublished: d.date.toISOString().slice(0, 10),
  recipeCategory: catName(d.category, lang), recipeCuisine: d.cuisine ? CUISINES[d.cuisine][lang] : undefined, inLanguage: lang === 'en' ? 'en' : 'zh-Hant', recipeYield: d.servings, prepTime: isoDuration(d.prepTime), totalTime: isoDuration(d.totalTime),
  recipeIngredient: d.ingredients.flatMap((g) => g.items.map((i) => `${i.name} ${i.amount}`.trim())),
  recipeInstructions: d.steps.map((s, i) => ({ '@type': 'HowToStep', name: s.title, text: s.text || s.title, url: `${pageUrl}#step-${i + 1}` })),
  nutrition: nu ? {
    '@type': 'NutritionInformation', servingSize: u.nutri.serving(nu.count), calories: `${nu.calories} kcal`,
    fatContent: `${nu.fat} g`, saturatedFatContent: `${nu.saturatedFat} g`, carbohydrateContent: `${nu.carbohydrate} g`,
    sugarContent: `${nu.sugar} g`, proteinContent: `${nu.protein} g`, fiberContent: `${nu.fiber} g`, sodiumContent: `${nu.sodium} mg`,
  } : undefined,
};
---
<Base title={d.title} description={d.intro} active={d.category} image={d.image} alt={altExists ? recipeUrl(recipe, other) : null}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <div class="wrap crumbs soft"><a href={lp(lang, '/')}>{u.home}</a> ／ <a href={categoryUrl(d.category, lang)}>{catName(d.category, lang)}</a> ／ {d.title}</div>
  <section class="wrap hero">
    <div class="copy">
      <Tag category={d.category} />
      <h1 class:list={['display', { long: longTitle, en: lang === 'en' }]}>{d.title}</h1>
      {d.titleFr && <div class="fr sub">{d.titleFr}</div>}
      <p class="muted intro">{d.intro}</p>
      {d.sample && <div class="sample-note">{u.sampleNote}</div>}
      <dl class="meta paper">
        {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="actions"><ScallopButton href="#cook" label={u.start} width={170} />
        <button type="button" class="fav" data-id={recipe.id} aria-pressed="false" aria-label={u.fav.aria}><svg class="heart" viewBox="0 0 24 22" width="22" height="20" aria-hidden="true"><path d="M12 20.5C6.2 16.4 1.8 12.6 1.8 7.4 1.8 4.3 4.1 2 7 2c2.1 0 3.8 1.1 5 3 1.2-1.9 2.9-3 5-3 2.9 0 5.2 2.3 5.2 5.4 0 5.2-4.4 9-10.2 13.1Z" /></svg><span class="off">{u.fav.add}</span><span class="on">{u.fav.on}</span></button>
        <button type="button" class="print-btn" onclick="window.print()"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 9V3h10v6 M7 17H4v-7h16v7h-3 M7 14h10v7H7Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span>{u.print}</span></button>
      </div>
    </div>
    {d.image && <img class="art" src={d.image} srcset={`${smallImage(d.image)} 720w, ${d.image} 1100w`} sizes="(max-width: 600px) 100vw, 600px" alt={u.illus(d.title)} width="1100" height="720" fetchpriority="high" />}
  </section>
  <img class="divider" src="/images/ui/divider.svg" alt="" aria-hidden="true" />
  <AdSlot name="recipeTop" />

  <section class="wrap body" id="cook" data-recipe={recipe.id}>
    <div class="ingredients paper">
      <span class="tape" style="background:var(--mustard)"></span>
      <div class="head"><h2 class="display">{u.ingredients}</h2><span class="fr">Ingrédients</span></div>
      {d.servings && <div class="serv">{u.servings} <strong>{d.servings}</strong></div>}
      {baseCount > 0 && (
        <div class="scaler" data-base={baseCount} data-ml={d.servingMl ?? ''} data-unit={unit}>
          <div class="sc-row">
            <span class="sc-label">{u.scale.label}</span>
            <span class="stepper">
              <button type="button" class="sc-minus" aria-label={u.scale.less}>−</button>
              <input class="sc-count" type="number" inputmode="decimal" min="1" step="1" value={baseCount} aria-label={u.scale.label} />
              <span class="sc-unit">{unit}</span>
              <button type="button" class="sc-plus" aria-label={u.scale.more}>＋</button>
            </span>
          </div>
          {d.servingMl && (
            <div class="sc-row">
              <span class="sc-label">{u.scale.each}</span>
              <span class="stepper"><input class="sc-ml" type="number" inputmode="decimal" min="10" step="5" value={d.servingMl} aria-label={u.scale.each} /><span class="sc-unit">ml</span></span>
              <span class="sc-total soft"></span>
            </div>
          )}
          <div class="sc-foot" hidden><span class="sc-factor"></span><button type="button" class="sc-reset">{u.scale.reset}</button></div>
          <p class="sc-note soft" hidden>{u.scale.note}</p>
          <script type="application/json" class="sc-i18n" set:html={JSON.stringify({ total: u.scale.total, times: u.scale.times })} />
        </div>
      )}
      {d.ingredients.map((g) => (
        <div class="group">
          {g.group && <div class="gname">{g.group}</div>}
          <ul>{g.items.map((i) => (
            <li><label><input type="checkbox" /><span class="box" aria-hidden="true"></span><span class="name">{i.name}</span><span class="amt" data-base={i.amount} data-egg={eggGrams(i.name, i.amount)}>{i.amount}</span></label></li>
          ))}</ul>
        </div>
      ))}
      <button type="button" class="shop-open"><svg viewBox="0 0 24 22" width="22" height="20" aria-hidden="true"><path d="M3 7h18l-2 11.5H5L3 7Z M8 7l3-5 M16 7l-3-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/><path d="M8 11v4 M12 11v4 M16 11v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>{u.shop.btn}</span></button>
      <p class="shop-hint soft">{u.shop.hint}</p>
      {nu && (
        <details class="nutri">
          <summary><span>{u.nutri.title}</span><span class="kc">{u.nutri.per(nu.count)} · {u.nutri.about(nu.calories)}</span></summary>
          <dl>
            {[[u.nutri.protein, `${nu.protein} g`], [u.nutri.fat, `${nu.fat} g`], [u.nutri.carb, `${nu.carbohydrate} g`], [u.nutri.sugar, `${nu.sugar} g`], [u.nutri.fiber, `${nu.fiber} g`], [u.nutri.sodium, `${nu.sodium} mg`]].map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="soft">{u.nutri.note}</p>
        </details>
      )}
    </div>
    <div class="steps" id="steps">
      <div class="section-title"><h2>{u.steps}</h2><span class="fr">Étapes</span></div>
      <p class="hint soft">{u.hint}<button type="button" class="reset" hidden>{u.reset}</button></p>
      <ol>{d.steps.map((s, i) => (
        <li id={`step-${i + 1}`}><label>
          <input type="checkbox" />
          <span class="num display" aria-hidden="true"><span class="n">{i + 1}</span></span>
          <span class="txt"><span class="sr-only">{u.stepN(i + 1)}</span><span class="st display">{s.title}</span><span class="sp muted">{s.text}</span></span>
        </label>
        {s.timer && (
          <div class="timers">{parseTimer(s.timer).map((t, j) => t.min ? (
            <span class="tgroup">
              <button type="button" class="timer" data-id={`${i}-${j}`} data-label={t.label || s.title} data-min={t.min} data-max={t.max}>
                <span class="ico" aria-hidden="true"></span><span class="tt">{t.text}</span><span class="cd"></span>
              </button>
              <button type="button" class="plus" data-for={`${i}-${j}`} hidden>{u.plus5}</button>
            </span>
          ) : <span class="timer static">⏱ {t.text}</span>)}</div>
        )}
        <p class="tmsg" hidden></p>
        </li>
      ))}</ol>
    </div>
  </section>

  <div class="band lower">
    {(d.tips.length > 0 || d.fails.length > 0 || d.storage.length > 0 || TRIVIA[recipe.id]) && (
      <section class="wrap notes">
        {d.tips.length > 0 && <Note title={u.tips} items={d.tips} bg="var(--paper-cream)" tape="var(--tape-sage)" tilt={-1} />}
        {d.fails.length > 0 && <Note title={u.fails} items={d.fails} tape="var(--tape-rose)" tilt={0.8} />}
        {d.storage.length > 0 && <Note title={u.storage} items={d.storage} tape="var(--dusty-blue)" tilt={-0.6} />}
        {TRIVIA[recipe.id] && <TriviaCard trivia={TRIVIA[recipe.id]} />}
      </section>
    )}
    <AdSlot name="recipeBottom" />
    {others.length > 0 && (
      <section class="wrap more">
        <div class="section-title"><h2>{u.alsoLike}</h2><span class="fr">à essayer aussi</span></div>
        <div class="card-grid">{others.map((r, i) => <RecipeCard recipe={r} index={i + 1} />)}</div>
      </section>
    )}
  </div>

  <div class="print-frame" aria-hidden="true"></div>
  {/* 列印時頁尾顯示「第 1 頁／共 2 頁」（Chrome、Edge 支援；Safari 目前不會顯示） */}
  <style is:inline set:html={`@media print { @page { margin-bottom: 11mm; @bottom-center { content: ${lang === 'en' ? '"Page " counter(page) " of " counter(pages)' : '"第 " counter(page) " 頁／共 " counter(pages) " 頁"'}; font-size: 9pt; color: #6B6553; font-family: Huninn, "PingFang TC", "Microsoft JhengHei", sans-serif; } } }`} />
  <p class="print-foot">{u.siteName} · {pageUrl.replace(/^https?:\/\//, '')}</p>
  <div class="timerbar" aria-live="polite"></div>
  <RollingPinProgress />
  <button type="button" class="cookmode" aria-pressed="false" hidden>
    <span class="dot" aria-hidden="true"></span>
    <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path d="M12 1.8v3 M12 19.2v3 M1.8 12h3 M19.2 12h3 M4.8 4.8l2.1 2.1 M17.1 17.1l2.1 2.1 M4.8 19.2l2.1-2.1 M17.1 6.9l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span><strong>{u.cook}</strong><small class="off">{u.cookOff}</small><small class="on">{u.cookOn}</small></span>
  </button>
  <script type="application/json" id="ui-timer" set:html={JSON.stringify(u.timer)} />
  <script type="application/json" id="ui-b" set:html={JSON.stringify({ toast: u.cookToast, now: u.nowHere, ding: u.ding, gotIt: u.gotIt, copied: u.shop.copied, empty: u.shop.empty,
    head: u.shop.head(d.title), url: pageUrl, c1: u.shop.count(1), cn: u.shop.count(999).replace('999', '{n}'), favOn: u.fav.on, favList: u.fav.seeList, favUrl: lp(lang, '/favorites/'), soundTip: u.soundTip })} />
  <div class="toast" role="status" aria-live="polite"></div>
  <div class="soundtip paper" role="dialog" aria-label={u.soundTest} hidden>
    <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M12 3a5 5 0 0 0-5 5v4.5L5 16h14l-2-3.5V8a5 5 0 0 0-5-5Z M10 19a2 2 0 0 0 4 0" fill="#EBC25F" stroke="#4A4536" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <p></p>
    <div class="st-btns"><button type="button" class="st-test">{u.soundTest}</button><button type="button" class="st-ok">{u.gotIt}</button></div>
  </div>
  <div class="ding paper" role="alertdialog" aria-live="assertive" hidden>
    <svg class="oven" viewBox="0 0 64 64" width="72" height="72" aria-hidden="true">
      <rect x="6" y="6" width="52" height="50" rx="8" fill="#F7EFD6" stroke="#4A4536" stroke-width="2"/>
      <circle cx="16" cy="15" r="3" fill="#B5552B"/><circle cx="25" cy="15" r="3" fill="#B5552B"/><rect x="36" y="12" width="15" height="6" rx="3" fill="#B5552B"/>
      <rect x="12" y="24" width="40" height="25" rx="5" fill="#EBC25F" stroke="#4A4536" stroke-width="1.6" class="win"/>
      <path d="M21 44c0-7 5-11 11-11s11 4 11 11Z" fill="#B5552B"/><path d="M27 37l2-2 M31 37l2-2 M35 37l2-2" stroke="#F7EFD6" stroke-width="1.4" stroke-linecap="round"/>
      <rect x="12" y="56" width="6" height="4" rx="1" fill="#9A4420"/><rect x="46" y="56" width="6" height="4" rx="1" fill="#9A4420"/>
    </svg>
    <div><strong class="display ding-t"></strong><p class="ding-m"></p></div>
    <button type="button" class="ding-ok">{u.gotIt}</button>
  </div>
  <dialog class="shop paper" aria-labelledby="shop-title" tabindex="-1">
    <span class="tape" style="background:var(--tape-sage)"></span>
    <h2 class="display" id="shop-title">{u.shop.title}</h2>
    <p class="shop-count soft"></p>
    <ul class="shop-list"></ul>
    <div class="shop-actions">
      <button type="button" class="shop-copy">{u.shop.copy}</button>
      <button type="button" class="shop-share" hidden>{u.shop.share}</button>
      <button type="button" class="shop-close">{u.shop.close}</button>
    </div>
  </dialog>
</Base>
<script>
  import { SANTA_HAT } from '../data/xmasArt';
  // 1. 烹飪模式：讓螢幕保持亮著（手機、iPad、電腦瀏覽器都支援；不支援的瀏覽器就不顯示按鈕）
  const B = JSON.parse(document.getElementById('ui-b')?.textContent || '{}');
  const toastEl = document.querySelector<HTMLElement>('.toast');
  let toastT = 0;
  const toast = (msg: string, ms = 4500) => { if (!toastEl) return; toastEl.textContent = msg; toastEl.classList.add('show');
    clearTimeout(toastT); toastT = window.setTimeout(() => toastEl.classList.remove('show'), ms); };
  // 烹飪模式開著時，標出「現在做到這裡」：第一個還沒打勾的步驟
  const stepLis = [...document.querySelectorAll<HTMLLIElement>('.steps ol > li')];
  const markNow = (scroll = false) => {
    const on = document.body.classList.contains('cooking');
    const cur = on ? stepLis.find((li) => !li.querySelector<HTMLInputElement>('input[type=checkbox]')!.checked) : undefined;
    stepLis.forEach((li) => { li.classList.toggle('now', li === cur); if (li === cur) li.dataset.now = B.now; });
    if (scroll && cur) { const r = cur.getBoundingClientRect(); if (r.top > innerHeight * 0.7 || r.bottom < 0) cur.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  };
  document.querySelector('.steps ol')?.addEventListener('change', () => markNow(true));
  const btn = document.querySelector<HTMLButtonElement>('.cookmode');
  let lock: any = null;
  const wl = (navigator as any).wakeLock;
  if (btn && wl) {
    btn.hidden = false;
    const setOn = (on: boolean) => { btn.setAttribute('aria-pressed', String(on)); document.body.classList.toggle('cooking', on); markNow(); };
    const request = async () => { try { lock = await wl.request('screen'); lock.addEventListener('release', () => { if (document.visibilityState === 'visible') setOn(false); }); setOn(true); } catch { setOn(false); } };
    btn.addEventListener('click', async () => {
      if (btn.getAttribute('aria-pressed') === 'true') { await lock?.release(); lock = null; setOn(false); toastEl?.classList.remove('show'); }
      else { await request(); if (btn.getAttribute('aria-pressed') === 'true') { toast(B.toast); markNow(true); } }
    });
    // 捲到材料和步驟時才出現，不會擋住上面的標題和按鈕；開著的時候一直顯示
    const cook = document.querySelector('#cook');
    if (cook && 'IntersectionObserver' in window) {
      btn.classList.add('away');
      new IntersectionObserver(([e]) => btn.classList.toggle('away', !e.isIntersecting)).observe(cook);
    }
    // 切到別的 App 再回來時，螢幕鎖會被系統放掉，自動再開一次
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && document.body.classList.contains('cooking') && (!lock || lock.released)) request(); });
  }

  // 3. 計時器：點時間按鈕開始倒數；時間到會響、會震動（Android），畫面上也會提示。
  //    用「結束時間」來算，就算切到別的 App、螢幕關掉再回來，剩下的時間還是對的。
  {
    const root = document.querySelector<HTMLElement>('#cook');
    const bar = document.querySelector<HTMLElement>('.timerbar')!;
    const KEY = 'pk-timers-' + (root?.dataset.recipe || '');
    type T = { end: number; done?: boolean; extra?: boolean };
    let state: Record<string, T> = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
    const btns = [...document.querySelectorAll<HTMLButtonElement>('button.timer')];
    const byId = (id: string) => btns.find((b) => b.dataset.id === id)!;
    const fmt = (sec: number) => { sec = Math.max(0, Math.ceil(sec)); const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
      return (h ? h + ':' + String(m).padStart(2, '0') : String(m)) + ':' + String(s).padStart(2, '0'); };
    let ctx: AudioContext | null = null;
    const unlock = () => {
      // iPhone：設成「播放」模式，靜音鍵打開時鈴聲也會響（Safari 17 以上）
      try { const as = (navigator as any).audioSession; if (as && as.type !== 'playback') as.type = 'playback'; } catch {}
      try { ctx = ctx || new (window.AudioContext || (window as any).webkitAudioContext)(); ctx.resume(); } catch {} };
    // 第一次按計時器：提醒會響鈴、可以試聽（每台裝置只提醒一次）
    const tip = document.querySelector<HTMLElement>('.soundtip');
    const showTip = () => {
      if (!tip) return; try { if (localStorage.getItem('pk-sound-tip')) return; localStorage.setItem('pk-sound-tip', '1'); } catch {}
      tip.querySelector('p')!.textContent = B.soundTip; tip.hidden = false; };
    tip?.querySelector('.st-test')?.addEventListener('click', () => { unlock(); beep(); });
    tip?.querySelector('.st-ok')?.addEventListener('click', () => { tip.hidden = true; });
    // 計時中讓螢幕保持亮著（螢幕自動鎖定時，網頁會被暫停，就不會響）
    const wl2 = (navigator as any).wakeLock; let tLock: any = null;
    const syncLock = async () => {
      const running = Object.values(state).some((t) => !t.done);
      if (running && wl2 && (!tLock || tLock.released) && document.visibilityState === 'visible') { try { tLock = await wl2.request('screen'); } catch {} }
      if (!running && tLock && !tLock.released) { try { await tLock.release(); } catch {} tLock = null; }
    };
    let ringing: number | null = null;
    // 聖誕節：鈴聲換成叮叮噹的鈴鐺（Jingle Bells 開頭三個音），跳出來的烤箱戴聖誕帽
    const xmasBell = document.documentElement.dataset.fest === 'xmas';
    const bell = () => { if (!ctx) return; const t0 = ctx.currentTime;
      [0, 0.22, 0.44].forEach((dt) => { [1, 2.76, 5.4].forEach((m, k) => { const o = ctx!.createOscillator(), g = ctx!.createGain(); o.type = 'sine'; o.frequency.value = 1318.5 * m;
        const v = [0.35, 0.12, 0.05][k]; g.gain.setValueAtTime(0.0001, t0 + dt); g.gain.exponentialRampToValueAtTime(v, t0 + dt + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dt + 0.5 - k * 0.12);
        o.connect(g).connect(ctx!.destination); o.start(t0 + dt); o.stop(t0 + dt + 0.55); }); }); };
    const beep = () => { if (!ctx) return; if (xmasBell) return bell(); const t0 = ctx.currentTime;
      for (let k = 0; k < 3; k++) { const o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'sine'; o.frequency.value = 880;
        g.gain.setValueAtTime(0.0001, t0 + k * 0.35); g.gain.exponentialRampToValueAtTime(0.4, t0 + k * 0.35 + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t0 + k * 0.35 + 0.25);
        o.connect(g).connect(ctx.destination); o.start(t0 + k * 0.35); o.stop(t0 + k * 0.35 + 0.3); } };
    const dingEl = document.querySelector<HTMLElement>('.ding');
    if (xmasBell && dingEl) { const hat = document.createElement('span'); hat.className = 'ding-hat'; hat.innerHTML = SANTA_HAT; dingEl.querySelector('.oven')!.after(hat); dingEl.classList.add('xmas'); }
    const showDing = () => { if (!dingEl) return; const done = btns.filter((b) => state[b.dataset.id!]?.done).map((b) => b.dataset.label);
      if (!done.length) { dingEl.hidden = true; return; }
      dingEl.querySelector('.ding-t')!.textContent = B.ding; dingEl.querySelector('.ding-m')!.textContent = done.map((l) => fill(L.barDone, { label: l! })).join('　');
      dingEl.hidden = false; dingEl.classList.remove('pop'); void dingEl.offsetWidth; dingEl.classList.add('pop'); };
    dingEl?.querySelector('.ding-ok')?.addEventListener('click', () => {
      for (const [id, t] of Object.entries(state)) if (t.done) delete state[id];
      save(); render(); dingEl.hidden = true; syncLock(); });
    const ring = () => { showDing(); if (ringing) return; let n = 0; beep(); try { navigator.vibrate?.([400, 200, 400, 200, 400]); } catch {}
      ringing = window.setInterval(() => { if (++n >= 15 || !Object.values(state).some((t) => t.done)) stopRing(); else beep(); }, 2000); };
    const stopRing = () => { if (ringing) clearInterval(ringing); ringing = null; };
    const title = document.title;
    const L = JSON.parse(document.getElementById('ui-timer')?.textContent || '{}');
    const fill = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k] ?? ''));
    const render = () => {
      const now = Date.now(); let anyDone = false; const rows: string[] = [];
      for (const b of btns) {
        const id = b.dataset.id!, t = state[id], li = b.closest('li')!, msg = li.querySelector<HTMLElement>('.tmsg')!;
        const plus = li.querySelector<HTMLButtonElement>(`.plus[data-for="${id}"]`)!;
        b.classList.toggle('running', !!t && !t.done); b.classList.toggle('done', !!t?.done);
        const cd = b.querySelector<HTMLElement>('.cd')!;
        if (!t) { cd.textContent = ''; b.setAttribute('aria-label', `${L.start}${b.dataset.label} ${fmt(+b.dataset.min!)}`); plus.hidden = true; if (!li.querySelector('.timer.done')) msg.hidden = true; continue; }
        if (t.done) { anyDone = true; cd.textContent = L.done; plus.hidden = false; b.setAttribute('aria-label', L.doneAria);
          const max = +b.dataset.max!, min = +b.dataset.min!;
          msg.hidden = false; msg.textContent = max > min && !t.extra ? fill(L.rangeMsg, { min: Math.round(min / 60), max: Math.round(max / 60) }) : fill(L.doneMsg, { label: b.dataset.label! });
          rows.push(`<button type="button" data-go="${id}" class="done">${fill(L.barDone, { label: b.dataset.label! })}</button>`); continue; }
        const left = (t.end - now) / 1000;
        cd.textContent = L.left + fmt(left); plus.hidden = true; msg.hidden = true;
        b.setAttribute('aria-label', `${b.dataset.label} ${fmt(left)}${L.leftAria}`);
        rows.push(`<button type="button" data-go="${id}">${b.dataset.label} ${fmt(left)}</button>`);
      }
      bar.innerHTML = rows.join(''); bar.classList.toggle('show', rows.length > 0);
      document.title = anyDone ? L.titlePrefix + title : title;
      if (!anyDone) { stopRing(); if (dingEl) dingEl.hidden = true; }
    };
    const tick = () => { const now = Date.now(); let fired = false;
      for (const [id, t] of Object.entries(state)) if (!t.done && t.end <= now) { t.done = true; fired = true; }
      if (fired) { save(); ring(); syncLock(); } render(); };
    let armed: string | null = null, armTimer = 0;
    btns.forEach((b) => b.addEventListener('click', () => {
      unlock(); const id = b.dataset.id!, t = state[id];
      if (!t) { state[id] = { end: Date.now() + +b.dataset.min! * 1000 }; save(); tick(); showTip(); syncLock(); return; }
      if (t.done) { delete state[id]; save(); render(); syncLock(); return; }
      // 倒數中：連點兩下才取消，避免手忙腳亂時不小心按掉
      if (armed === id) { delete state[id]; armed = null; save(); render(); syncLock(); return; }
      armed = id; clearTimeout(armTimer); b.querySelector<HTMLElement>('.cd')!.textContent = L.cancel;
      armTimer = window.setTimeout(() => { armed = null; render(); }, 2500);
    }));
    document.querySelectorAll<HTMLButtonElement>('.plus').forEach((p) => p.addEventListener('click', () => {
      unlock(); const id = p.dataset.for!; state[id] = { end: Date.now() + 5 * 60 * 1000, extra: true }; save(); tick(); syncLock(); }));
    bar.addEventListener('click', (e) => { const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]'); if (!go) return;
      byId(go.dataset.go!).closest('li')!.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
    // 重新整理後，已經過了的計時直接顯示「時間到」
    for (const t of Object.values(state)) if (!t.done && t.end <= Date.now()) t.done = true;
    render(); setInterval(tick, 1000);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') { tick(); syncLock(); } });
    syncLock();
  }

  // 4. 份量調整：輸入要做幾份（和每份容量），材料份量自動換算
  {
    const sc = document.querySelector<HTMLElement>('.scaler');
    if (sc) {
      const base = Number(sc.dataset.base), baseMl = Number(sc.dataset.ml) || 0;
      const countIn = sc.querySelector<HTMLInputElement>('.sc-count')!, mlIn = sc.querySelector<HTMLInputElement>('.sc-ml');
      const totalEl = sc.querySelector<HTMLElement>('.sc-total'), foot = sc.querySelector<HTMLElement>('.sc-foot')!, note = sc.querySelector<HTMLElement>('.sc-note')!;
      const factorEl = sc.querySelector<HTMLElement>('.sc-factor')!;
      const T = JSON.parse(sc.querySelector('.sc-i18n')?.textContent || '{}');
      const amts = [...document.querySelectorAll<HTMLElement>('.amt[data-base]')];
      const KEY = 'pk-scale-' + (document.querySelector<HTMLElement>('#cook')?.dataset.recipe || '');
      const nice = (x: number) => {
        if (x >= 100) return String(Math.round(x / 5) * 5);
        if (x >= 10) return String(Math.round(x));
        const r = Math.round(x * 4) / 4;            // 小數字取到 0.25
        return r === 0 ? String(Math.round(x * 100) / 100) : String(r);
      };
      const scaleText = (t: string, f: number) => t.replace(/(\d+(?:\.\d+)?)(?:\s*\/\s*(\d+))?/g, (_, a, b) => nice((b ? Number(a) / Number(b) : Number(a)) * f));
      const apply = (save = true) => {
        const n = Math.max(0.5, Number(countIn.value) || base);
        const ml = mlIn ? Math.max(1, Number(mlIn.value) || baseMl) : baseMl;
        const f = (n * (baseMl ? ml : 1)) / (base * (baseMl || 1));
        const same = Math.abs(f - 1) < 0.001;
        amts.forEach((a) => {
          if (same) { a.textContent = a.dataset.base!; return; }
          let t = scaleText(a.dataset.base!, f);
          const eg = Number(a.dataset.egg);
          if (eg) { const n = parseFloat(a.dataset.base!) * f; if (Math.abs(n - Math.round(n)) > 0.05) t += `（≈ ${Math.round(n * eg)} g）`; }
          a.textContent = t;
        });
        if (totalEl) totalEl.textContent = baseMl ? `${T.total} ${nice(n * ml)} ml` : '';
        factorEl.textContent = `× ${Math.round(f * 100) / 100}`;
        foot.hidden = same; note.hidden = same;
        sc.classList.toggle('changed', !same);
        if (save) { try { same ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, JSON.stringify({ n, ml })); } catch {} }
      };
      sc.querySelector('.sc-minus')!.addEventListener('click', () => { countIn.value = String(Math.max(1, (Number(countIn.value) || base) - 1)); apply(); });
      sc.querySelector('.sc-plus')!.addEventListener('click', () => { countIn.value = String((Number(countIn.value) || base) + 1); apply(); });
      countIn.addEventListener('input', () => apply());
      mlIn?.addEventListener('input', () => apply());
      sc.querySelector('.sc-reset')!.addEventListener('click', () => { countIn.value = String(base); if (mlIn) mlIn.value = String(baseMl); apply(); });
      try { const s = JSON.parse(localStorage.getItem(KEY) || 'null'); if (s) { countIn.value = String(s.n); if (mlIn && s.ml) mlIn.value = String(s.ml); } } catch {}
      apply(false);
    }
  }

  // 2. 材料和步驟的勾選會記住（重新整理或螢幕關掉再打開都還在）
  const root = document.querySelector<HTMLElement>('#cook');
  if (root) {
    const key = 'pk-checks-' + root.dataset.recipe;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const reset = root.querySelector<HTMLButtonElement>('.reset');
    const sync = () => { if (reset) reset.hidden = !boxes.some((b) => b.checked); };
    try { const saved = JSON.parse(localStorage.getItem(key) || '[]'); boxes.forEach((b, i) => (b.checked = !!saved[i])); } catch {}
    sync();
    root.addEventListener('change', () => { try { localStorage.setItem(key, JSON.stringify(boxes.map((b) => b.checked))); } catch {} sync(); });
    reset?.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); try { localStorage.removeItem(key); } catch {} sync(); markNow(); });
  }
  markNow();

  // 5. 購物清單：還沒打勾的材料（份量照「要做多少」換算後的數字）
  {
    const dlg = document.querySelector<HTMLDialogElement>('dialog.shop');
    const open = document.querySelector<HTMLButtonElement>('.shop-open');
    if (dlg && open) {
      const list = dlg.querySelector<HTMLElement>('.shop-list')!, count = dlg.querySelector<HTMLElement>('.shop-count')!;
      const copyBtn = dlg.querySelector<HTMLButtonElement>('.shop-copy')!, shareBtn = dlg.querySelector<HTMLButtonElement>('.shop-share')!;
      let text = '';
      const build = () => {
        const groups = [...document.querySelectorAll<HTMLElement>('.ingredients .group')];
        const lines: string[] = []; let html = ''; let n = 0;
        groups.forEach((g) => {
          const gname = g.querySelector('.gname')?.textContent?.trim();
          const items = [...g.querySelectorAll('li')].filter((li) => !li.querySelector<HTMLInputElement>('input')!.checked)
            .map((li) => ({ name: li.querySelector('.name')!.textContent!.trim(), amt: li.querySelector('.amt')!.textContent!.trim() }));
          if (!items.length) return;
          if (gname) { const h = document.createElement('li'); h.className = 'g'; h.textContent = gname; html += h.outerHTML; lines.push('', `【${gname}】`); }
          items.forEach((i) => { n++; const li = document.createElement('li'); li.innerHTML = '<span></span><span class="a"></span>';
            li.children[0].textContent = i.name; li.children[1].textContent = i.amt; html += li.outerHTML; lines.push(`□ ${i.name}　${i.amt}`); });
        });
        list.innerHTML = html || `<li class="empty">${B.empty}</li>`;
        count.textContent = n ? (n === 1 ? B.c1 : B.cn.replace('{n}', String(n))) : '';
        copyBtn.hidden = !n; shareBtn.hidden = !n || !navigator.share;
        text = [B.head, ...lines, '', B.url].join('\n').replace(/\n\n\n/g, '\n\n');
      };
      open.addEventListener('click', () => { build(); dlg.showModal(); dlg.scrollTop = 0; dlg.focus(); });
      dlg.querySelector('.shop-close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      copyBtn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); } catch { const ta = document.createElement('textarea'); ta.value = text; dlg.append(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
        const old = copyBtn.textContent; copyBtn.textContent = B.copied; setTimeout(() => (copyBtn.textContent = old), 1800);
      });
      shareBtn.addEventListener('click', () => { navigator.share({ title: B.head, text }).catch(() => {}); });
    }
  }

  // 6. 我想做：按愛心把食譜存到這台裝置（首頁會出現「我想做的食譜」）
  {
    const fav = document.querySelector<HTMLButtonElement>('button.fav');
    if (fav) {
      const id = fav.dataset.id!;
      const get = (): string[] => { try { return JSON.parse(localStorage.getItem('pk-favs') || '[]'); } catch { return []; } };
      const set = (a: string[]) => { try { localStorage.setItem('pk-favs', JSON.stringify(a)); } catch {} };
      const show = () => fav.setAttribute('aria-pressed', String(get().includes(id)));
      show();
      fav.addEventListener('click', () => {
        const a = get(); const on = !a.includes(id);
        set(on ? [id, ...a] : a.filter((x) => x !== id)); show();
        dispatchEvent(new Event('pk-favs'));
        if (on) { fav.classList.remove('beat'); void fav.offsetWidth; fav.classList.add('beat');
          toast(B.favOn, 4000); const a = document.createElement('a'); a.href = B.favUrl; a.textContent = B.favList + ' →'; toastEl?.append(' ', a); }
      });
    }
  }
</script>
