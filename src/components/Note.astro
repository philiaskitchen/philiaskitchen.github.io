---
interface Props { title: string; items: string[]; bg?: string; tape?: string; tilt?: number }
const { title, items, bg = 'var(--paper)', tape = 'var(--tape-sage)', tilt = -1 } = Astro.props;
---
<div class="note paper" style={`background:${bg};--tilt:${tilt}deg`}>
  <span class="tape" style={`background:${tape}`}></span>
  <h3 class="display">{title}</h3>
  <ul>{items.map((i) => <li>{i}</li>)}</ul>
</div>
<style>
  .note { position: relative; flex: 1; min-width: 0; padding: 28px 28px 22px; transform: rotate(var(--tilt)); }
  h3 { font-size: 26px; line-height: 1.3; }
  ul { font-size: 15px; line-height: 2; color: var(--ink-muted); padding-left: 20px; margin: 8px 0 0; }
</style>
