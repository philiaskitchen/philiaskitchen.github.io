---
import { featuredRecipe, recipeUrl, categoryUrl } from '../site';
import { getLang, lp, t } from '../i18n';
interface Props { active?: string; home?: boolean; altHref?: string }
const { active = '', home = false, altHref } = Astro.props;
const lang = getLang(Astro.url);
const u = t(lang);
const featured = await featuredRecipe(lang);
const items = [
  { key: 'week', label: u.nav.week, href: featured ? recipeUrl(featured, lang) : lp(lang, '/') },
  { key: 'taiwanese', label: u.nav.taiwanese, href: categoryUrl('taiwanese', lang) },
  { key: 'french', label: u.nav.french, href: categoryUrl('french', lang) },
  { key: 'bread', label: u.nav.bread, href: categoryUrl('bread', lang) },
  { key: 'sweets', label: u.nav.sweets, href: categoryUrl('sweets', lang) },
  { key: 'about', label: u.nav.about, href: lp(lang, '/about/') },
];
---
<header>
  <img class="awning" src="/images/ui/awning.svg" alt="" aria-hidden="true" />
  <div class:list={['wrap', 'bar', { home }]}>
    <a class="brand" href={lp(lang, '/')} aria-label={`${u.siteName} ${u.homeAria}`}>
      {home && <span class="issue fr">N° 01 · automne 2026</span>}
      <img class="logo" src={u.logo} alt={u.siteName} />
      <span class="fr tagline">la cuisine de Philia</span>
    </a>
    <nav aria-label={u.mainNav}>
      {altHref && <a class="lang" href={altHref} hreflang={u.switchLang === 'en' ? 'en' : 'zh-Hant'} lang={u.switchLang === 'en' ? 'en' : 'zh-Hant'} aria-label={u.switchLabel}>{u.switchTo}</a>}
      <details class="menu">
        <summary aria-label={u.openMenu}><svg width="30" height="22" viewBox="0 0 30 22" aria-hidden="true"><path d="M2,3 Q15,1 28,4 M2,11 Q15,12 28,10 M2,19 Q15,18 28,20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></summary>
        <ul>
          {items.map((i) => (
            <li><a href={i.href} aria-current={i.key === active ? 'page' : undefined} class:list={{ on: i.key === active }}>{i.label}</a></li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
  <img class="divider" src="/images/ui/divider.svg" alt="" aria-hidden="true" />
</header>
<style>
  header { padding-bottom: 6px; }
  .awning { width: 100%; height: 44px; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding-top: 10px; padding-bottom: 10px; gap: 20px; }
  .brand { display: flex; flex-direction: column; }
  .logo { height: 34px; width: auto; }
  .tagline { color: var(--terracotta-ink); font-size: 15px; line-height: 1.3; }
  .issue { display: none; }
  .bar.home { flex-direction: column; text-align: center; padding-top: 14px; }
  .bar.home .brand { align-items: center; }
  .bar.home .issue { display: block; font-size: 13px; letter-spacing: .3em; color: var(--ink-soft); font-style: normal; text-transform: uppercase; }
  .bar.home .logo { height: 64px; margin: 4px 0 2px; }
  .bar.home .tagline { font-size: 24px; }
  nav { display: flex; align-items: center; gap: 30px; }
  .lang { order: 2; font-size: 13px; letter-spacing: .04em; color: var(--ink-soft); border: 1.2px solid rgba(74, 69, 54, .5); border-radius: 14px 12px 15px 13px; padding: 3px 11px 2px; white-space: nowrap; }
  .lang:hover { color: var(--terracotta-ink); border-color: var(--terracotta-ink); }
  .bar.home nav { flex-direction: column; gap: 10px; }
  .bar.home .lang { position: absolute; top: 56px; right: max(30px, env(safe-area-inset-right)); }
  .bar { position: relative; }
  summary { display: none; list-style: none; cursor: pointer; color: var(--pencil); padding: 6px; }
  summary::-webkit-details-marker { display: none; }
  ul { display: flex; gap: 34px; list-style: none; margin: 0; padding: 0; font-size: 15px; }
  li a { display: inline-block; padding-bottom: 6px; }
  li a.on { background: url(/images/ui/underline.svg) no-repeat bottom / 100% 10px; }
  li a:hover { color: var(--terracotta-ink); }
  /* 讓 details 在桌機永遠展開 */
  @media (min-width: 761px) { .menu > ul { display: flex !important; } }
  @media (max-width: 760px) {
    .bar, .bar.home { flex-direction: row; text-align: left; align-items: center; }
    .bar.home .brand { align-items: flex-start; }
    .bar.home .issue { display: none; }
    .logo, .bar.home .logo { height: 26px; margin: 0; }
    .tagline, .bar.home .tagline { font-size: 13px; }
    summary { display: block; }
    nav, .bar.home nav { flex-direction: row; gap: 10px; }
    .bar.home .lang { position: static; }
    .lang { order: 0; }
    .menu { position: relative; }
    .menu:not([open]) > ul { display: none; }
    .menu[open] > ul { position: absolute; right: 0; top: 44px; z-index: 60; flex-direction: column; gap: 4px; background: var(--paper);
      box-shadow: var(--shadow-paper); padding: 14px 22px; min-width: 170px; }
  }
</style>
<script>
  // 桌機：選單永遠打開；手機：點漢堡才打開
  const d = document.querySelector('header .menu') as HTMLDetailsElement | null;
  const mq = matchMedia('(min-width: 761px)');
  const sync = () => { if (d) d.open = mq.matches; };
  sync(); mq.addEventListener('change', sync);
</script>
