---
import Tag from './Tag.astro';
import { recipeUrl, metaLine, type Recipe } from '../site';
interface Props { recipe: Recipe; index?: number }
const { recipe, index = 0 } = Astro.props;
const d = recipe.data;
const tilts = [-1.2, 0.9, -0.6, 1.1];
const tapes = ['var(--mustard)', 'var(--tape-sage)', 'var(--dusty-blue)', 'var(--tape-rose)'];
---
<a class="card" href={recipeUrl(recipe)} style={`--tilt:${tilts[index % 4]}deg`}>
  <span class="tape" style={`background:${tapes[index % 4]}`}></span>
  <span class="img">
    {d.image ? <img src={d.image} alt={`${d.title}插圖`} loading="lazy" /> : <span class="ph">插圖待生成</span>}
  </span>
  <Tag category={d.category} />
  <span class="title display">{d.title}</span>
  {d.titleFr && <span class="fr sub">{d.titleFr}</span>}
  <span class="meta">{metaLine(recipe)}</span>
</a>
<style>
  .card { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: 26px 22px 22px; background-color: var(--paper);
    box-shadow: var(--shadow-paper); transform: rotate(var(--tilt));
    background-image: repeating-linear-gradient(transparent 0 31px, var(--rule-blue) 31px 32px); background-position: 0 18px;
    transition: transform .2s ease; }
  .card:hover { transform: rotate(0deg) translateY(-4px); }
  .img { align-self: stretch; height: 200px; display: flex; align-items: center; justify-content: center; margin: 0 -6px 8px; }
  .img img { max-height: 100%; width: auto; max-width: 100%; }
  .ph { width: 86%; height: 170px; border: 1.5px dashed var(--pencil); opacity: .55; display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--ink-soft); }
  .title { font-size: 28px; line-height: 1.3; }
  .sub { color: var(--olive-ink); font-size: 17px; line-height: 1.3; }
  .meta { font-size: 14px; color: var(--ink-soft); margin-top: 8px; }
</style>
