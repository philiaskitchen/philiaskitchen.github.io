---
import { categoryUrl } from '../site';
import EmailLink from './EmailLink.astro';
import { getLang, lp, t } from '../i18n';
const lang = getLang(Astro.url);
const u = t(lang);
---
<footer class="band">
  <div class="wrap inner">
    <div>
      <img src={u.logo} alt={u.siteName} class="logo" />
      <div class="fr" style="color:var(--terracotta-ink);font-size:17px">à bientôt dans la cuisine</div>
      <p class="small muted">{u.footerLine} · © 2026 · <a class="plink" href={lp(lang, '/privacy/')}>{u.privacy}</a> · <EmailLink class="plink" label={u.contact} /></p>
    </div>
    <nav aria-label={u.footerNav}>
      <a href={categoryUrl('taiwanese', lang)}>{u.nav.taiwanese}</a><a href={categoryUrl('french', lang)}>{u.nav.french}</a><a href={categoryUrl('bread', lang)}>{u.nav.bread}</a><a href={categoryUrl('sweets', lang)}>{u.nav.sweets}</a><a href={lp(lang, '/about/')}>{u.nav.about}</a>
    </nav>
  </div>
</footer>
<style>
  footer { border-top: 1px solid rgba(74, 69, 54, .15); }
  .inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; padding-top: 34px; padding-bottom: 34px; }
  .logo { height: 28px; width: auto; }
  .small { font-size: 13px; margin-top: 10px; }
  .small :global(.plink) { border-bottom: 1px solid currentColor; }
  .small :global(.plink:hover) { color: var(--terracotta-ink); }
  nav { display: flex; gap: 24px; font-size: 14px; flex-wrap: wrap; }
  nav a:hover { color: var(--terracotta-ink); }
</style>
