---
// 料理小知識翻卡：正面「你知道嗎？」＋問題，點一下翻到背面看答案和資料來源
import type { Trivia } from '../data/trivia';
import { getLang, t } from '../i18n';
interface Props { trivia: Trivia }
const lang = getLang(Astro.url);
const u = t(lang);
const tv = Astro.props.trivia;
const c = tv[lang];
---
<div class="trivia" style="--tilt:1deg">
  <button type="button" class="flip" aria-pressed="false" aria-label={`${u.trivia.label}：${c.q}`}>
    <span class="face front paper">
      <span class="tape" style="background:var(--mustard)"></span>
      <span class="fr kicker">le saviez-vous ?</span>
      <span class="display ttl">{u.trivia.title}</span>
      <span class="q">{c.q}</span>
      <span class="hint">{u.trivia.tap} ↻</span>
    </span>
    <span class="face back paper" aria-hidden="true">
      <span class="q small">{c.q}</span>
      <span class="a">{c.a}</span>
      <span class="hint">{u.trivia.back} ↻</span>
    </span>
  </button>
  <a class="src" href={tv.src.url} target="_blank" rel="noopener">{u.trivia.source}：{tv.src.label}</a>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.trivia').forEach((el) => {
    const b = el.querySelector<HTMLButtonElement>('.flip')!;
    const back = el.querySelector<HTMLElement>('.back')!, front = el.querySelector<HTMLElement>('.front')!;
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on)); el.classList.toggle('flipped', on);
      back.setAttribute('aria-hidden', String(!on)); front.setAttribute('aria-hidden', String(on));
    });
  });
</script>
<style>
  .trivia { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; transform: rotate(var(--tilt)); perspective: 1200px; }
  .flip { position: relative; display: grid; flex: 1; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: left; cursor: pointer;
    transform-style: preserve-3d; transition: transform .6s cubic-bezier(.3, 1.3, .5, 1); min-height: 230px; }
  .flipped .flip { transform: rotateY(180deg); }
  .face { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 8px; padding: 28px 26px 20px; backface-visibility: hidden; -webkit-backface-visibility: hidden; position: relative; }
  .front { background: var(--paper); background-image: radial-gradient(rgba(217, 164, 58, .18) 1.2px, transparent 1.6px); background-size: 14px 14px; }
  .back { background: var(--paper-cream); transform: rotateY(180deg); }
  .kicker { color: var(--terracotta-ink); font-size: 17px; line-height: 1; }
  .ttl { font-size: 26px; line-height: 1.3; }
  .q { font-size: 17px; line-height: 1.6; color: var(--ink); }
  .q.small { font-size: 14px; color: var(--terracotta-ink); }
  .a { font-size: 15px; line-height: 1.9; color: var(--ink-muted); }
  .hint { margin-top: auto; padding-top: 6px; font-size: 13px; color: var(--olive-ink); }
  .flip:hover .front .hint { color: var(--terracotta-ink); }
  .src { align-self: flex-end; font-size: 12px; color: var(--ink-soft); border-bottom: 1px solid rgba(74, 69, 54, .35); }
  .src:hover { color: var(--terracotta-ink); }
  @media (prefers-reduced-motion: reduce) { .flip { transition: none; } }
  @media print { .trivia { display: none; } }
</style>
