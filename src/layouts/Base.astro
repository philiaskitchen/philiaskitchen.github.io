---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ADS } from '../site';
import { getLang, lp, stripLang, t, HTML_LANG } from '../i18n';
// alt：另一個語言的同一頁路徑（中文頁就是英文路徑，反之亦然）。
// 不傳就自動用同一個路徑；傳 null 表示另一個語言沒有這頁（例如還沒翻譯的食譜）。
interface Props { title?: string; description?: string; active?: string; home?: boolean; image?: string; alt?: string | null }
const lang = getLang(Astro.url);
const u = t(lang);
const other = u.switchLang;
const basePath = stripLang(Astro.url.pathname);
const { title, description = u.defaultDesc, active, home = false, image = '/images/site/og.jpg', alt = lp(other, basePath) } = Astro.props;
const fullTitle = title ? `${title}${lang === 'en' ? ' | ' : '｜'}${u.siteName}` : u.siteName;
const altHref = alt ?? lp(other, '/');
const hasAlt = alt !== null;
const zhUrl = lang === 'zh' ? Astro.url.pathname : alt;
const enUrl = lang === 'en' ? Astro.url.pathname : alt;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hasAlt && zhUrl && <link rel="alternate" hreflang="zh-Hant" href={new URL(zhUrl, Astro.site)} />}
  {hasAlt && enUrl && <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)} />}
  {hasAlt && zhUrl && <link rel="alternate" hreflang="x-default" href={new URL(zhUrl, Astro.site)} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.png" />
  <link rel="preload" href="/fonts/jf-openhuninn-2.1.woff2?v=2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_AU' : 'zh_TW'} />
  <meta property="og:site_name" content={u.siteName} />
  <meta name="theme-color" content="#DDE3D2" />
  {ADS.client && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>}
  <script is:inline>if (/[?&]ads=preview/.test(location.search)) document.documentElement.classList.add('show-ad-preview');</script>
  <slot name="head" />
</head>
<body>
  <Header active={active} home={home} altHref={altHref} />
  <main><slot /></main>
  <Footer />
  <script is:inline>
    document.querySelectorAll('a.email-link').forEach(function (a) {
      var e = a.dataset.u + '@' + a.dataset.d;
      a.href = 'mailto:' + e;
      if (a.dataset.show) a.textContent = e;
    });
  </script>
</body>
</html>
