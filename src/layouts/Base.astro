---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seasonal from '../components/Seasonal.astro';
import { ADS, GA_ID } from '../site';
import { getLang, lp, stripLang, t, HTML_LANG } from '../i18n';
// alt：另一個語言的同一頁路徑（中文頁就是英文路徑，反之亦然）。
// 不傳就自動用同一個路徑；傳 null 表示另一個語言沒有這頁（例如還沒翻譯的食譜）。
interface Props { title?: string; description?: string; active?: string; home?: boolean; image?: string; alt?: string | null }
const lang = getLang(Astro.url);
const u = t(lang);
const other = u.switchLang;
const basePath = stripLang(Astro.url.pathname);
const { title, description = u.defaultDesc, active, home = false, image = '/images/site/og.jpg', alt = lp(other, basePath) } = Astro.props;
const fullTitle = title ? `${title}${lang === 'en' ? ' | ' : '｜'}${u.siteName}` : u.siteName;
const altHref = alt ?? lp(other, '/');
const hasAlt = alt !== null;
const zhUrl = lang === 'zh' ? Astro.url.pathname : alt;
const enUrl = lang === 'en' ? Astro.url.pathname : alt;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const gaOn = Boolean(GA_ID) && import.meta.env.PROD;
// 自動語言：給下方 script 用的另一個語言網址（沒有對應頁面時是空字串，就不跳轉）
const langAlt = hasAlt && alt ? alt : '';
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="p:domain_verify" content="fcbb4e18e27cb59f161dbe79b0f43897" />
  {/* 自動語言：中文瀏覽器看中文，其他語言看英文；讀者按過語言切換就照他選的；搜尋引擎爬蟲不跳轉 */}
  <script is:inline define:vars={{ PAGE_LANG: lang, LANG_ALT: langAlt }}>
    (function () {
      var KEY = 'pk-lang';
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a.lang');
        if (a) try { localStorage.setItem(KEY, PAGE_LANG === 'zh' ? 'en' : 'zh'); } catch (err) {}
      });
      if (!LANG_ALT || /bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
      var want = null;
      try { want = localStorage.getItem(KEY); } catch (err) {}
      if (want !== 'zh' && want !== 'en') {
        var b = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
        want = b.indexOf('zh') === 0 ? 'zh' : 'en';
      }
      if (want !== PAGE_LANG) {
        document.documentElement.style.visibility = 'hidden';
        location.replace(LANG_ALT + location.search + location.hash);
      }
    })();
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hasAlt && zhUrl && <link rel="alternate" hreflang="zh-Hant" href={new URL(zhUrl, Astro.site)} />}
  {hasAlt && enUrl && <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)} />}
  {hasAlt && zhUrl && <link rel="alternate" hreflang="x-default" href={new URL(enUrl ?? zhUrl, Astro.site)} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-v3.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v3.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/jf-openhuninn-2.1.woff2?v=2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_AU' : 'zh_TW'} />
  <meta property="og:site_name" content={u.siteName} />
  <meta name="theme-color" content="#DDE3D2" />
  {/* GA4：網址加 ?me=1 會把這個瀏覽器標記成「自己人」，之後不再計入 GA；?me=0 取消 */}
  {gaOn && <script is:inline define:vars={{ GA_ID }}>
    var KEY = 'pk-no-ga', me = (location.search.match(/[?&]me=([01])/) || [])[1], self = false;
    try {
      if (me === '1') localStorage.setItem(KEY, '1');
      if (me === '0') localStorage.removeItem(KEY);
      self = localStorage.getItem(KEY) === '1';
    } catch (e) { self = me === '1'; }
    window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} window.gtag = gtag;
    if (self) {
      window['ga-disable-' + GA_ID] = true;
    } else {
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      gtag('js', new Date()); gtag('config', GA_ID);
    }
    if (me) addEventListener('DOMContentLoaded', function () {
      var n = document.createElement('div');
      n.textContent = self ? '已設定：這個瀏覽器不會計入 GA 流量 ✓' : '已取消：這個瀏覽器會計入 GA 流量';
      n.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;background:#2f3a2a;color:#fff;padding:10px 16px;border-radius:999px;font-size:14px;box-shadow:0 4px 14px rgba(0,0,0,.2)';
      document.body.appendChild(n); setTimeout(function () { n.remove(); }, 4000);
    });
  </script>}
  {ADS.client && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>}
  <script is:inline>if (/[?&]ads=preview/.test(location.search)) document.documentElement.classList.add('show-ad-preview');</script>
  <slot name="head" />
</head>
<body>
  <Header active={active} home={home} altHref={altHref} />
  <Seasonal home={home} />
  <main><slot /></main>
  <Footer />
  <script is:inline>
    document.querySelectorAll('a.email-link').forEach(function (a) {
      var e = a.dataset.u + '@' + a.dataset.d;
      a.href = 'mailto:' + e;
      if (a.dataset.show) a.textContent = e;
    });
  </script>
</body>
</html>
